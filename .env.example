# ==============================================================================
# Configurações do Ambiente de Testes E2E / Funcionais - SGE Cajuí (IFNMG)
# ==============================================================================

# URL Base da aplicação Cajuí em execução (ex: container Apache na porta 8000)
TEST_BASE_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# Configurações do WebDriver (ChromeDriver / Selenium Standalone)
# ------------------------------------------------------------------------------
WEBDRIVER_HOST=127.0.0.1
WEBDRIVER_PORT=4444
WEBDRIVER_BROWSER=chrome
WEBDRIVER_HEADLESS=false
WEBDRIVER_WAIT_TIMEOUT=10

# ------------------------------------------------------------------------------
# Senha padrão das contas de teste (ambiente de homologação/desenvolvimento)
# ------------------------------------------------------------------------------
TEST_DEFAULT_PASSWORD=123

# ------------------------------------------------------------------------------
# 1. CONTAS INSTITUCIONAIS PADRÃO (UNIVERSAIS NO CAJUÍ)
# ------------------------------------------------------------------------------
# As contas abaixo seguem a convenção padrão de seeder institucional do Cajuí:
# apelido no formato "nome.sobrenome123456". São universais em qualquer base de
# dados populada com os seeders padrão do IFNMG.
TEST_ADMIN_LOGIN=administrador

TEST_ALUNO_BSI_LOGIN=gloria.smith157938
TEST_ALUNO_BSI2_LOGIN=ruben.olson185556
TEST_ALUNO_TEC_LOGIN=rita.yang180282

TEST_ORIENTADOR_LOGIN=joshua.ross118643
TEST_COORD_ESTAGIO_LOGIN=alan.carter180333
TEST_COORD_CURSO_LOGIN=steven.floyd104448

# ------------------------------------------------------------------------------
# 2. CONTAS EXTERNAS DE EMPRESAS CONCEDENTES (NÃO UNIVERSAIS - CONFIGURAR ABAIXO)
# ------------------------------------------------------------------------------
# ATENÇÃO: As contas de Responsável Legal e de Supervisor de Empresa NÃO são
# geradas automaticamente pelos seeders padrão do Cajuí. Elas foram cadastradas
# especificamente no banco de dados local do autor, assim como as empresas,
# convênios, apólices de seguro e registros de estágios vinculados.
#
# Caso você esteja executando os testes em uma máquina diferente ou com uma base
# de dados limpa, altere os logins abaixo para os usuários representantes/supervisores
# que você cadastrou no seu Cajuí local:
TEST_RESP_EMPRESA_LOGIN=jgdf
TEST_SUPERVISOR_EMPRESA_LOGIN=laf
