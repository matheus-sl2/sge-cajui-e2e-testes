# Configurações do Ambiente de Testes E2E (SGE Cajuí)

# URL Base da aplicação Cajuí (ambiente de desenvolvimento/teste)
TEST_BASE_URL=http://localhost:8080

# Configurações do WebDriver (ChromeDriver / Selenium Standalone)
WEBDRIVER_HOST=127.0.0.1
WEBDRIVER_PORT=4444
WEBDRIVER_BROWSER=chrome

# Executar navegador sem interface gráfica (true para CI/CD ou background, false para visualizar o navegador)
WEBDRIVER_HEADLESS=false

# Timeout padrão de espera dos elementos em segundos
WEBDRIVER_WAIT_TIMEOUT=10

# Credenciais de teste (ambiente de homologação/teste)
TEST_ADMIN_LOGIN=admin
TEST_ADMIN_PASSWORD=senha_admin_teste

TEST_ALUNO_LOGIN=aluno_teste
TEST_ALUNO_PASSWORD=senha_aluno_teste

TEST_ORIENTADOR_LOGIN=orientador_teste
TEST_ORIENTADOR_PASSWORD=senha_orientador_teste
